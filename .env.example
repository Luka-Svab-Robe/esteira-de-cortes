# =====================================================================
#  Esteira Canal Dark — variáveis de ambiente
#  Copie este arquivo para ".env" (o instalador faz isso) e preencha.
#  Nenhuma chave é obrigatória: sem elas a esteira usa alternativas
#  gratuitas e avisa no diagnóstico (python esteira.py diagnostico).
# =====================================================================

# ---------------------------------------------------------------------
# 1) Modelo de linguagem (roteiro, SEO, ajuste fonético, anti-duplicidade)
# ---------------------------------------------------------------------
# auto | anthropic | openai | gemini | groq | openrouter | ollama | nenhum
#   auto  -> usa o primeiro provedor com chave configurada; se não houver,
#            o agente de IA (Claude Code/Codex) escreve o roteiro (--modo-agente)
#            ou a esteira usa o gerador heurístico sem LLM.
LLM_PROVEDOR=auto
# Esforço de raciocínio (Anthropic): low | medium | high | xhigh | max
LLM_ESFORCO=medium

ANTHROPIC_API_KEY=
ANTHROPIC_MODELO=claude-opus-5-5
# 1 = ativa fallback automático do servidor caso o modelo recuse a solicitação
ANTHROPIC_FALLBACK=1

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODELO=gpt-4.1-mini

GEMINI_API_KEY=
GEMINI_MODELO=gemini-2.5-flash

GROQ_API_KEY=
GROQ_MODELO=llama-3.3-70b-versatile

OPENROUTER_API_KEY=
OPENROUTER_MODELO=meta-llama/llama-3.3-70b-instruct

OLLAMA_URL=http://localhost:11434/v1
OLLAMA_MODELO=qwen2.5:7b

# ---------------------------------------------------------------------
# 2) Pesquisa na internet (opcional — sem chave usa Wikipédia + DuckDuckGo)
# ---------------------------------------------------------------------
BRAVE_API_KEY=
TAVILY_API_KEY=
PESQUISA_MAX_PAGINAS=6

# ---------------------------------------------------------------------
# 3) Bancos de mídia gratuitos (vídeos e fotos)
#    Pexels:  https://www.pexels.com/api/   (grátis)
#    Pixabay: https://pixabay.com/api/docs/ (grátis)
#    Sem chaves: imagens Creative Commons do Openverse + cenas 2D geradas.
# ---------------------------------------------------------------------
PEXELS_API_KEY=
PIXABAY_API_KEY=
# Recomendado: um e-mail ou site seu. A Wikimedia (origem da maioria das imagens livres do
# Openverse) pede contato no User-Agent e limita mais os downloads de quem não informa.
CONTATO_USER_AGENT=

# Imagem gerada por IA: pollinations (grátis, online) | comando | nenhum
#   Sem token, o Pollinations libera 1 imagem a cada ~45 s por IP, em 1024 px e com marca d'água
#   no rodapé (a esteira espera o intervalo e recorta a marca). Com um token ("pollen key",
#   https://enter.pollinations.ai) não há espera.
IMAGEM_IA_PROVEDOR=pollinations
POLLINATIONS_URL=https://image.pollinations.ai/prompt/{prompt}?width={largura}&height={altura}&seed={semente}&nologo=true&model=flux
POLLINATIONS_TOKEN=
POLLINATIONS_INTERVALO_SEG=46
# Para usar um gerador local (ex.: Stable Diffusion/ComfyUI na sua GPU):
# IMAGEM_IA_PROVEDOR=comando
# IMAGEM_IA_COMANDO=python meu_gerador.py --prompt "{prompt}" --saida "{saida}" --largura {largura} --altura {altura}
IMAGEM_IA_COMANDO=

# ---------------------------------------------------------------------
# 4) Voz e auditoria de pronúncia
# ---------------------------------------------------------------------
KOKORO_MODELO=modelos/kokoro/kokoro-v1.0.int8.onnx
KOKORO_VOZES=modelos/kokoro/voices-v1.0.bin
# tiny | base | small | medium | large-v3  (small = bom equilíbrio em CPU)
WHISPER_MODELO=small
# auto | cpu | cuda
WHISPER_DISPOSITIVO=auto
# Taxa máxima de erro de pronúncia (WER) antes de regerar o bloco
LIMITE_ERRO_PRONUNCIA=0.08
MAX_TENTATIVAS_NARRACAO=3

# ---------------------------------------------------------------------
# 5) Vídeo
# ---------------------------------------------------------------------
# auto | libx264 | h264_nvenc | h264_videotoolbox | h264_qsv | h264_amf
VIDEO_ENCODER=auto
VIDEO_PRESET=veryfast
VIDEO_CRF=20
FFMPEG_BIN=
FFPROBE_BIN=

# ---------------------------------------------------------------------
# 6) YouTube Data API v3 (OAuth2)
#    Baixe o JSON "ID do cliente OAuth – App para computador" no
#    Google Cloud Console e salve no caminho abaixo.
# ---------------------------------------------------------------------
YOUTUBE_CLIENT_SECRETS=credenciais/client_secret.json

# ---------------------------------------------------------------------
# 7) Painel de revisão
# ---------------------------------------------------------------------
PAINEL_PORTA=8765
PAINEL_ABRIR_NAVEGADOR=1
